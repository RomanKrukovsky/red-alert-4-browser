{
  "name": "red-alert-4-browser",
  "version": "1.0.0",
  "private": true,
  "description": "AAA Browser RTS based on RA4 Bible v2.0 - 4 Asymmetric Factions, Deterministic Simulation, Babylon.js WebGPU/WebGL2, Node.js Server",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "content:validate": "pnpm --filter @ra4/content-runtime validate",
    "test:determinism": "pnpm --filter @ra4/testing test:determinism",
    "test:lifecycle": "pnpm --filter @ra4/testing test:lifecycle",
    "test:navigation": "pnpm --filter @ra4/testing test:navigation",
    "test:combat": "pnpm --filter @ra4/testing test:combat",
    "test:economy": "pnpm --filter @ra4/testing test:economy",
    "test:building": "pnpm --filter @ra4/testing test:building",
    "test:ai": "pnpm --filter @ra4/testing test:ai",
    "assets:fetch": "npx tsx tools/asset-pipeline/fetch-assets.ts",
    "assets:verify": "npx tsx tools/asset-pipeline/verify-assets.ts",
    "assets:process": "npx tsx tools/asset-pipeline/process-assets.ts",
    "assets:build": "npx tsx tools/asset-pipeline/build-all-models.ts",
    "assets:report": "npx tsx tools/asset-pipeline/report-assets.ts",
    "ui:references": "npx tsx tools/ui-pipeline/references.ts",
    "ui:screenshots": "npx tsx tools/ui-pipeline/screenshots.ts",
    "ui:compare": "npx tsx tools/ui-pipeline/compare.ts",
    "ui:test": "npx tsx tools/ui-pipeline/test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.20.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.5.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
