{
  "name": "@ra4/testing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:determinism": "node ./dist/determinismRunner.js",
    "test:lifecycle": "node ./dist/lifecycle.test.js",
    "test:navigation": "node ./dist/navigation.test.js",
    "test:combat": "node ./dist/combat.test.js",
    "test:economy": "node ./dist/economy.test.js",
    "test:building": "node ./dist/building.test.js",
    "test:ai": "node ./dist/aiRegression.test.js && node ./dist/aiMatch.test.js",
    "test:server": "vitest run apps/game-server/src/__tests__/server*.test.ts",
    "test:protocol": "vitest run apps/game-server/src/__tests__/serverAuth.test.ts",
    "test:reconnect": "vitest run apps/game-server/src/__tests__/serverReconnect.test.ts",
    "test:security": "vitest run apps/game-server/src/__tests__/serverAdmin.test.ts",
    "test:replay": "vitest run apps/game-server/src/__tests__/serverMatchRuntime.test.ts",
    "test:navigation-scale": "node ./dist/navigationScale.test.js",
    "test:protocol-v1": "node ./dist/protocol.test.js",
    "test:replay-v2": "node ./dist/replayV2.test.js"
  },
  "dependencies": {
    "@ra4/shared-types": "workspace:*",
    "@ra4/sim-core": "workspace:*",
    "@ra4/replay": "workspace:*",
    "@ra4/ui": "workspace:*",
    "@ra4/netcode": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
