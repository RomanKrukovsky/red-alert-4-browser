# Server Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Versioning Metadata
PROTOCOL_VERSION=1.0.0
CONTENT_VERSION=1.0.0
SIM_CORE_VERSION=1.0.0

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-ra4-production-change-me
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_SECRET_KEY=admin-secret-bootstrap-key

# Database (PostgreSQL)
DATABASE_URL=postgres://ra4user:ra4pass@localhost:5432/ra4db

# Redis
REDIS_URL=redis://localhost:6379

# Server Flags & Limits
RATE_LIMIT_MAX=100
MAX_CONNECTIONS_PER_IP=10
RECONNECT_WINDOW_SECONDS=60
